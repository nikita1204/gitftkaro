# Next.js Frontend Environment Variables
# IMPORTANT: Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Keep secrets out of client-side code!

# Base URL pointing to the Express backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Application Metadata
NEXT_PUBLIC_APP_NAME=GIFT KRO
NEXT_PUBLIC_APP_ENV=development

# Razorpay Client Key (Public test key only)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key
