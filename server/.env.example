# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Connection String)
# Note: Server will start in detached/degraded mode if MongoDB is not reachable
MONGODB_URI=mongodb://127.0.0.1:27017/gift_kro_dev

# Security & CORS Configuration
# Set the exact origin of the frontend application (no wildcard in production)
CLIENT_URL=http://localhost:3000

# Authentication Infrastructure (JWT Secrets)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long_here
JWT_EXPIRES_IN=7d

# API Rate Limiting (Window in milliseconds, max requests per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Razorpay Payment Gateway Configuration (Test/Live Placeholders)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
